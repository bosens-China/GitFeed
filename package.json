{
  "name": "gitfeed",
  "version": "1.0.0",
  "description": "A cross-platform, local-first Git weekly report desktop app",
  "desktopName": "com.yliu.gitfeed.desktop",
  "main": "./out/main/index.js",
  "author": "yliu",
  "license": "MIT",
  "homepage": "https://github.com/bosens-China/GitFeed#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosens-China/GitFeed.git"
  },
  "bugs": {
    "url": "https://github.com/bosens-China/GitFeed/issues"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run build && electron-builder --linux",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{cjs,css,html,js,json,jsonc,jsx,md,mdx,mjs,scss,ts,tsx,yaml,yml}": "prettier --write"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-virtual": "^3.14.6",
    "ahooks": "^3.9.7",
    "antd": "^6.5.1",
    "dayjs": "^1.11.21",
    "es-toolkit": "^1.49.0",
    "execa": "8.0.1",
    "i18next": "^26.3.6",
    "lucide-react": "^1.25.0",
    "react-i18next": "^17.0.10"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@unocss/reset": "^66.9.2",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "unocss": "^66.7.5",
    "vite": "^7.2.6",
    "vitest": "^3.2.4"
  }
}
